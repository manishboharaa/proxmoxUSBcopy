#!/usr/bin/env bash
# Fake pct for installer tests.
#
# Read-only output for dry-runs; mutating calls are logged so tests can prove
# what the installer would do. `exec` emulates the few command results the
# installer consumes without touching a real container.
set -euo pipefail

log() {
    if [[ -n ${USBC_FAKE_LOG:-} ]]; then
        printf '%s\n' "$*" >>"$USBC_FAKE_LOG"
    fi
}

log "pct $*"

command=${1:-}
case "$command" in
    list)
        printf 'VMID       Status     Lock         Name\n'
        printf '100        stopped                 legacy-ct\n'
        ;;
    status)
        state=${USBC_FAKE_STATE_DIR:-/nonexistent}
        if [[ ${USBC_FAKE_CT_QUERY_FAIL:-0} == 1 ]]; then
            printf 'connection to cluster failed\n' >&2
            exit 1
        fi
        if [[ ${USBC_FAKE_CT_MISSING:-0} == 1 ]]; then
            printf "Configuration file 'nodes/test/lxc/%s.conf' does not exist\n" "${2:-101}" >&2
            exit 2
        fi
        if [[ -e $state/ct-stopped || (${USBC_FAKE_CT_STOPPED:-0} == 1 && ! -e $state/ct-running) ]]; then
            printf 'status: stopped\n'
        else
            printf 'status: running\n'
        fi
        ;;
    config)
        if [[ ${USBC_FAKE_PCT_CONFIG_FAIL:-0} == 1 ]]; then
            printf 'configuration query failed\n' >&2
            exit 1
        fi
        if [[ -n ${USBC_FAKE_PCT_CONFIG:-} ]]; then
            cat -- "$USBC_FAKE_PCT_CONFIG"
            exit 0
        fi
        printf 'hostname: %s\n' "${USBC_FAKE_CT_HOSTNAME:-usbcopy}"
        ;;
    create | start | stop | destroy | push)
        state=${USBC_FAKE_STATE_DIR:-/nonexistent}
        case "$command" in
            start)
                mkdir -p -- "$state"
                rm -f -- "$state/ct-stopped"
                : >"$state/ct-running"
                ;;
            stop)
                mkdir -p -- "$state"
                rm -f -- "$state/ct-running"
                : >"$state/ct-stopped"
                ;;
            destroy)
                rm -f -- "$state/ct-running" "$state/ct-stopped"
                if [[ ${USBC_FAKE_PCT_DESTROY_FAIL:-0} == 1 ]]; then
                    printf 'destroy failed\n' >&2
                    exit 1
                fi
                ;;
        esac
        if [[ $command == push && -n ${USBC_FAKE_PUSH_DIR:-} ]]; then
            # pct push <vmid> <source> <destination>
            src=${3:-}
            dest=${4:-}
            if [[ -n $src && -n $dest && -f $src ]]; then
                mkdir -p -- "$USBC_FAKE_PUSH_DIR"
                cp -- "$src" "$USBC_FAKE_PUSH_DIR/${dest##*/}"
            fi
        fi
        ;;
    set)
        shift
        (($# > 0)) && shift
        while (($# > 0)); do
            option=$1
            value=${2:-}
            case "$option" in
                -mp[0-9]*)
                    slot=${option#-}
                    log "$slot: $value"
                    if [[ -n ${USBC_FAKE_PCT_SET_RO_FAIL:-} && $value == *,ro=1 ]]; then
                        exit 1
                    fi
                    shift 2
                    ;;
                *)
                    shift
                    ;;
            esac
        done
        ;;
    exec)
        shift
        (($# > 0)) && shift
        [[ ${1:-} == -- ]] && shift
        joined="$*"
        last=''
        for arg in "$@"; do
            last=$arg
        done
        if [[ $joined == *'.usbcopy-permission-test'* ]]; then
            log 'verify_permissions'
        fi
        case "$joined" in
            *'id -u usbcopy'*)
                if [[ ${USBC_FAKE_ID_FAIL:-0} == 1 ]]; then
                    exit 1
                fi
                if [[ ${USBC_FAKE_USER_ABSENT:-0} == 1 \
                    && ! -e ${USBC_FAKE_STATE_DIR:-/nonexistent}/user-created ]]; then
                    exit 1
                fi
                printf '%s\n' "${USBC_FAKE_USBCOPY_UID:-999}"
                ;;
            *'id -g usbcopy'*)
                if [[ ${USBC_FAKE_ID_FAIL:-0} == 1 ]]; then
                    exit 1
                fi
                printf '%s\n' "${USBC_FAKE_USBCOPY_GID:-999}"
                ;;
            *'useradd '*)
                mkdir -p -- "${USBC_FAKE_STATE_DIR:-/nonexistent}"
                : >"${USBC_FAKE_STATE_DIR:-/nonexistent}/user-created"
                ;;
            *'dpkg -s '*)
                if [[ " ${USBC_FAKE_PRESENT_PACKAGES:-} " == *" $last "* ]]; then
                    exit 0
                fi
                exit 1
                ;;
            *'hash_password'*)
                cat >/dev/null
                if [[ -n ${USBC_FAKE_HASH_FAIL:-} ]]; then
                    exit 1
                fi
                printf '%s\n' "${USBC_FAKE_BCRYPT_HASH:-\$2b\$12\$abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789}"
                ;;
            *'socket'*)
                port=$last
                if [[ " ${USBC_FAKE_BUSY_PORTS:-} " == *" $port "* ]]; then
                    exit 1
                fi
                ;;
            *'systemctl is-active'*)
                exit 0
                ;;
            *'grep -E ^port'*)
                printf 'port = %s\n' "${USBC_FAKE_CONFIG_PORT:-8089}"
                ;;
            *'curl '*)
                printf '{"status":"ok"}\n'
                ;;
            *'hostname -I'*)
                printf '%s\n' "${USBC_FAKE_CT_IP:-10.0.0.50}"
                ;;
            *'ls -A /mnt/usb'* | *'find /mnt/usb'*)
                if [[ ${USBC_FAKE_SOURCE_UNREADABLE:-0} == 1 ]]; then
                    exit 1
                fi
                if [[ -n ${USBC_FAKE_USB_ENTRY:-} ]]; then
                    printf '%s\n' "$USBC_FAKE_USB_ENTRY"
                fi
                ;;
            *'findmnt -n -o TARGET -T'*)
                if [[ ${USBC_FAKE_FINDMNT_FAIL:-0} == 1 ]]; then
                    exit 20
                fi
                found=''
                for mount_path in ${USBC_FAKE_CT_MOUNT_STUCK:-}; do
                    if [[ $last == "$mount_path" || $last == "$mount_path"/* ]]; then
                        found=$mount_path
                        break
                    fi
                done
                if [[ -n $found ]]; then
                    printf '%s' "$found"
                    exit 0
                fi
                exit 10
                ;;
            *'findmnt --mountpoint'*)
                if [[ " ${USBC_FAKE_CT_MISSING_MOUNT:-} " == *" $last "* ]]; then
                    exit 1
                fi
                if [[ -n ${USBC_FAKE_MOUNTPOINTS+x} || -n ${USBC_FAKE_CT_MOUNT_STUCK+x} ]]; then
                    if [[ " ${USBC_FAKE_MOUNTPOINTS:-} ${USBC_FAKE_CT_MOUNT_STUCK:-} " == *" $last "* ]]; then
                        exit 0
                    fi
                    exit 1
                fi
                ;;
            *'runuser'*)
                if [[ -n ${USBC_FAKE_VERIFY_FAIL_DEST:-} \
                    && $joined == *"${USBC_FAKE_VERIFY_FAIL_DEST}"* \
                    && $joined == *'.usbcopy-permission-test'* ]]; then
                    exit 1
                fi
                if [[ -n ${USBC_FAKE_VERIFY_FAIL_PATH:-} \
                    && $joined == *"${USBC_FAKE_VERIFY_FAIL_PATH}"* \
                    && $joined == *'.usbcopy-permission-test'* ]]; then
                    exit 1
                fi
                ;;
            *)
                ;;
        esac
        ;;
    *)
        ;;
esac
