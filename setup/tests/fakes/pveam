#!/usr/bin/env bash
# Fake pveam for installer tests.
set -euo pipefail

if [[ -n ${USBC_FAKE_LOG:-} ]]; then
    printf 'pveam %s\n' "$*" >>"$USBC_FAKE_LOG"
fi

case "$*" in
    list*)
        if [[ ${USBC_FAKE_TEMPLATE_ABSENT:-0} == 1 ]]; then
            exit 0
        fi
        printf 'local:vztmpl/debian-12-standard_12.7-1_amd64.tar.zst 120.00MB\n'
        ;;
    available*)
        printf 'debian-12-standard_12.7-1_amd64.tar.zst\n'
        ;;
    *)
        ;;
esac
