#!/usr/bin/env bash
# Fake curl for installer tests: connectivity succeeds unless asked to fail,
# and bootstrap downloads can be satisfied from a prepared archive.
set -euo pipefail

if [[ -n ${USBC_FAKE_LOG:-} ]]; then
    printf 'curl %s\n' "$*" >>"$USBC_FAKE_LOG"
fi

if [[ -n ${USBC_FAKE_CURL_FAIL:-} ]]; then
    exit 22
fi

output=''
previous=''
for arg in "$@"; do
    if [[ $previous == -o ]]; then
        output=$arg
    fi
    previous=$arg
done

if [[ -n $output && $output != /dev/null && -n ${USBC_FAKE_CURL_ARCHIVE:-} ]]; then
    cp -- "$USBC_FAKE_CURL_ARCHIVE" "$output"
fi
